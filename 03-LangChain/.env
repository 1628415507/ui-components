# DASHSCOPE_API_KEY=your_dashscope_api_key_here（换成百炼的key）
# DASHCOPE_KEY=your_dashscope_api_key_here


#如果报 KeyError: 'request' 错可能就是模型免费额度了，要换模型
# 通义千问 - 聊天模型 (ChatTongyi)
TONGYI_CHAT_MODEL_NAME=deepseek-v4-flash

# 通义千问 - 基础语言模型 (Tongyi LLM)
TONGYI_LLM_MODEL_NAME=qwen-max

# Ollama 模型
OLLAMA_CHAT_MODEL_NAME=qwen3:4b
OLLAMA_EMBEDDING_MODEL_NAME=qwen3-embedding:4b
